# Banco de dados. Local: SQLite; no Railway use a URL do plugin Postgres.
DATABASE_URL=sqlite:///./gestao_giras.db
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Login Google (deixe vazio em desenvolvimento para rodar sem login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAILS_PERMITIDOS=casadavobenedita@gmail.com

# Assina o cookie de sessão. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção, defina um valor forte e único em SECRET_KEY; não comite .env
SECRET_KEY=
# Origens permitidas (vírgula-separado). Em produção, configurar explicitamente, ex:
# ALLOWED_ORIGINS=https://meusite.com,https://outro.com
ALLOWED_ORIGINS=
# Em produção (HTTPS) use true
COOKIE_HTTPS_ONLY=false
