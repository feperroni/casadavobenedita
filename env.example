# Banco de dados. Local: SQLite; no Railway use a URL do plugin Postgres.
DATABASE_URL=sqlite:///./gestao_giras.db
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Login Google. Vazio em desenvolvimento roda sem login; em PRODUÇÃO as três
# variáveis abaixo são obrigatórias e a aplicação se recusa a subir sem elas —
# sem login configurado o cadastro do terreiro ficaria aberto a quem tivesse
# o endereço.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails autorizados, separados por vírgula. Não há valor padrão: fora desta
# lista ninguém entra, mesmo com uma conta Google válida.
EMAILS_PERMITIDOS=

# Assina o cookie de sessão. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção, defina um valor forte e único em SECRET_KEY; não comite .env
SECRET_KEY=
# Origens permitidas (vírgula-separado). Em produção, configurar explicitamente, ex:
# ALLOWED_ORIGINS=https://meusite.com,https://outro.com
ALLOWED_ORIGINS=
# Cookie de sessão só por HTTPS. Sem a variável, o padrão acompanha o
# APP_ENV: true em produção, false em desenvolvimento.
COOKIE_HTTPS_ONLY=

# Leitura do estoque por foto (Gemini, nível gratuito). Sem esta chave o botão
# "Conferir por foto" simplesmente não aparece — o resto do estoque funciona
# igual, na mão. Gere a chave em https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Modelo a usar (opcional). O Google costuma aposentar modelo do nível
# gratuito com pouco aviso — se a leitura por foto passar a falhar com 404
# "no longer available", troque aqui pelo nome que a própria mensagem de erro
# sugere, sem precisar editar o código. Deixe vazio para usar o padrão.
GEMINI_MODEL=
